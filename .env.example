# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3002
DEFAULT_CURRENCY=KES
TZ=Africa/Nairobi

# ── Database / queue ─────────────────────────────────────────────────
# Embedded local postgres (npm run db:start)
DATABASE_URL=postgresql://hiregari:hiregari@127.0.0.1:55432/hiregari?schema=public
# Docker postgres alternative: postgresql://hiregari:hiregari@127.0.0.1:5432/hiregari?schema=public
REDIS_URL=
QUEUE_DRIVER=inline

# ── Auth / security ──────────────────────────────────────────────────
SESSION_SECRET=dev-session-secret-change-me-min-32-bytes-long
SESSION_TTL_HOURS=720
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5
ENCRYPTION_KEY=ZGV2LWtleS0zMi1ieXRlcy1sb25nLWxvbmctbG9uZyEhIQ==
CSRF_ENABLED=false
ADMIN_MFA_REQUIRED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ENABLED=false

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=af-south-1
S3_BUCKET_PRIVATE=hiregari-private
S3_BUCKET_PUBLIC=hiregari-public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=8

# ── Payments (sandbox/mock only outside production) ──────────────────
PAYMENT_DRIVER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=http://localhost:4000
CARD_PROVIDER=mock
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=
CARD_WEBHOOK_SECRET=

# ── Business rules — placeholders, see docs/15-business-legal-decisions.md
COMMISSION_BPS=1500
DEPOSIT_RULE=FIXED
DEPOSIT_FIXED_CENTS=2000000
DEPOSIT_PERCENT_BPS=2000
DEPOSIT_DAILY_MULTIPLIER_BPS=200
DEPOSIT_RELEASE_HOURS=48
QUOTE_TTL_MINUTES=15
HOLD_TTL_MINUTES=15
HOST_REQUEST_TIMEOUT_MINUTES=240
PAYMENT_WINDOW_MINUTES=20
PAYOUT_COOLDOWN_HOURS=72
MIN_DRIVER_AGE=23
DOC_EXPIRY_REMINDER_DAYS=30,14,3
TAX_BPS=0

# ── Communications ───────────────────────────────────────────────────
SMS_DRIVER=mock
EMAIL_DRIVER=mock
EMAIL_FROM=Hiregari <no-reply@hiregari.dev>
SUPPORT_EMAIL=support@hiregari.dev
SUPPORT_PHONE_E164=+254700000000
SUPPORT_WHATSAPP_E164=+254700000000

# ── Integrations ─────────────────────────────────────────────────────
MAPS_DRIVER=mock
MAPS_API_KEY=
KYC_DRIVER=manual
ANALYTICS_DRIVER=noop
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=

# ── Ops ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug
RECONCILE_INTERVAL_MINUTES=30
WEBHOOK_MAX_ATTEMPTS=8
DEMO_SEED=true
ALLOW_DEMO_SEED=false
