{
  "name": "@hiregari/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --no-warnings -r @swc-node/register -r tsconfig-paths/register src/main.ts",
    "start": "node --env-file-if-exists=.env -r @swc-node/register -r tsconfig-paths/register src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force && node --env-file-if-exists=.env -r @swc-node/register -r tsconfig-paths/register src/db/post-constraints.ts",
    "db:migrate": "node -r @swc-node/register -r tsconfig-paths/register src/db/migrate.ts && node --env-file-if-exists=.env -r @swc-node/register -r tsconfig-paths/register src/db/post-constraints.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file-if-exists=.env -r @swc-node/register -r tsconfig-paths/register src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@hiregari/types": "*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@hiregari/testing": "*",
    "@nestjs/testing": "^11.2.3",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~3.2.7"
  }
}