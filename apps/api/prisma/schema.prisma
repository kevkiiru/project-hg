// ============================================================
// Identity & access
// ============================================================

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String?    @unique()
  emailNormalized   String?    @unique()
  phoneE164         String?    @unique()
  passwordHash      String?
  googleSubject     String?    @unique()
  appleSubject      String?    @unique()
  firstName         String
  lastName          String
  avatarObjectKey   String?
  status            UserStatus @default(REGISTERED)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  mfaSecretEnc      String?
  mfaEnrolledAt     DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  locale            String     @default("en")
  isDemo            Boolean    @default(false)
  metadata          Json       @default("{}")
  anonymizedAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  sessions          Session[]
  otpChallenges     OtpChallenge[]
  authTokens        AuthToken[]
  roleAssignments   RoleAssignment[]
  customerProfile   CustomerProfile?
  hostProfile       HostProfile?
  notifications     Notification[]
  analyticsEvents   AnalyticsEvent[]
  consentRecords    ConsentRecord[]

  @@index([status])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  csrfSecret    String?
  userAgent     String?
  ip            String?
  lastUsedAt    DateTime  @default(now())
  mfaVerifiedAt DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  channel     OtpChannel
  purpose     OtpPurpose
  to          String
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([to, purpose, createdAt])
  @@map("otp_challenges")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  role        Role
  scopeType   ScopeType @default(GLOBAL)
  scopeId     String?
  grantedById String?   @db.Uuid
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([role, scopeType, scopeId])
  @@map("role_assignments")
}

model CustomerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  legalFirstName     String
  legalLastName      String
  dob                DateTime?
  nationality        String?
  countryOfResidence String?
  photoObjectKey     String?
  verificationStatus VerificationStatus @default(NOT_STARTED)
  verifiedAt         DateTime?
  verificationNote   String?
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverVerification DriverVerification?
  addresses          Address[]

  @@map("customer_profiles")
}

model Address {
  id            String           @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String           @db.Uuid
  label         String?
  country       String           @default("KE")
  county        String?
  city          String?
  neighbourhood String?
  street        String?
  landmark      String?
  postalCode    String?
  lat           Float?
  lng           Float?
  isPrimary     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  customerProfile   CustomerProfile? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("addresses")
}

model ConsentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  purpose     String
  version     String
  granted     Boolean
  ip          String?
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consent_records")
}

// ============================================================
// Hosts / businesses / verification documents
// ============================================================

model HostProfile {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @db.Uuid
  type                  HostType         @default(INDIVIDUAL)
  status                HostStatus       @default(PENDING)
  brandName             String?
  bio                   String?
  avatarObjectKey       String?
  payoutProvider        String?
  payoutAccountRefEnc   String?
  payoutReadyAt         DateTime?
  submittedAt           DateTime?
  decidedAt             DateTime?
  decidedById           String?          @db.Uuid
  decisionNote          String?
  ratingAverage         Float            @default(0)
  ratingCount           Int              @default(0)
  isDemo                Boolean          @default(false)
  metadata              Json             @default("{}")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses            Business[]
  vehicles              Vehicle[]
  deliveryZones         DeliveryZone[]
  bookings              Booking[]
  payouts               Payout[]

  @@index([status])
  @@map("host_profiles")
}

model Business {
  id                           String               @id @default(uuid()) @db.Uuid
  hostProfileId               String               @db.Uuid
  name                         String
  registrationNumber           String?
  kraPinEnc                    String?
  phone                        String?
  email                        String?
  authorizedRepresentativeName String?
  authorizedRepresentativeUserId String?           @db.Uuid
  verificationStatus           VerificationStatus  @default(NOT_STARTED)
  submittedAt                  DateTime?
  decidedAt                    DateTime?
  decidedById                  String?              @db.Uuid
  decisionNote                 String?
  metadata                     Json                 @default("{}")
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  hostProfile                  HostProfile          @relation(fields: [hostProfileId], references: [id], onDelete: Cascade)
  members                      BusinessMember[]
  vehicles                     Vehicle[]

  @@index([verificationStatus])
  @@map("businesses")
}

model BusinessMember {
  id           String               @id @default(uuid()) @db.Uuid
  businessId   String               @db.Uuid
  userId       String               @db.Uuid
  staffRole    String
  permissions  String[]             @default([])
  status       BusinessMemberStatus @default(INVITED)
  invitedById  String?              @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model VerificationDocument {
  id               String              @id @default(uuid()) @db.Uuid
  ownerType        DocumentOwnerType
  ownerId          String              @db.Uuid
  documentType     String
  objectKey        String
  fileName         String
  contentType      String
  sizeBytes        Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  status           DocumentStatus      @default(PENDING)
  reviewerId       String?             @db.Uuid
  reviewedAt       DateTime?
  reviewNote       String?
  providerReference String?
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([ownerType, ownerId])
  @@index([status, expiresAt])
  @@map("verification_documents")
}

model DriverVerification {
  id                  String               @id @default(uuid()) @db.Uuid
  customerProfileId   String               @unique @db.Uuid
  status              VerificationStatus   @default(NOT_STARTED)
  legalFirstName      String
  legalLastName       String
  dob                 DateTime?
  nationality         String?
  idType              KycIdType?
  idNumberEnc         String?
  licenceNumberEnc    String?
  licenceCountry      String?
  licenceIssuedAt     DateTime?
  licenceExpiresAt    DateTime?
  selfieObjectKey     String?
  effectiveExpiryAt   DateTime?
  submittedAt         DateTime?
  reviewerId          String?              @db.Uuid
  reviewedAt          DateTime?
  rejectionReasons    String[]             @default([])
  providerReference   String?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customerProfile     CustomerProfile      @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("driver_verifications")
}

model RiskEvent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @db.Uuid
  bookingId   String?        @db.Uuid
  type        String
  signals     Json           @default("{}")
  riskScore   Int            @default(0)
  resolution  RiskResolution @default(OPEN)
  reviewerId  String?        @db.Uuid
  note        String?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([resolution, createdAt])
  @@index([userId])
  @@map("risk_events")
}

// ============================================================
// Locations
// ============================================================

model Location {
  id            String       @id @default(uuid()) @db.Uuid
  kind          LocationKind
  country       String       @default("KE")
  county        String?
  city          String?
  neighbourhood String?
  name          String
  slug          String       @unique
  lat           Float
  lng           Float
  suggested     Boolean      @default(false)
  sortOrder     Int          @default(0)
  aliases       String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([county, kind])
  @@map("locations")
}

// ============================================================
// Vehicles / catalogue
// ============================================================

model Vehicle {
  id                  String           @id @default(uuid()) @db.Uuid
  hostProfileId       String           @db.Uuid
  businessId          String?          @db.Uuid
  reference           String           @unique
  slug                String           @unique
  status              VehicleStatus    @default(DRAFT)
  title               String?
  make                String
  model               String
  year                Int
  category            VehicleCategory
  transmission        Transmission?
  fuelType            FuelType?
  seats               Int?
  doors               Int?
  engineCapacityCc    Int?
  drivetrain          Drivetrain?
  bodyColour          String?
  licensePlateEnc     String?
  instantBookEnabled  Boolean          @default(false)
  selfDriveEnabled    Boolean          @default(true)
  chauffeurEnabled    Boolean          @default(false)
  ac                   Boolean         @default(false)
  description         String?
  ratingAverage       Float            @default(0)
  ratingCount         Int              @default(0)
  submittedAt         DateTime?
  decidedAt           DateTime?
  decidedById         String?          @db.Uuid
  rejectionReason     String?
  isDemo              Boolean          @default(false)
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  hostProfile         HostProfile      @relation(fields: [hostProfileId], references: [id], onDelete: Cascade)
  business            Business?        @relation(fields: [businessId], references: [id])
  images              VehicleImage[]
  features            VehicleFeature[]
  documents           VehicleDocument[]
  location            VehicleLocation?
  pricing             VehiclePricing?
  blocks              AvailabilityBlock[]
  pricingRules        PricingRule[]
  extras              RentalExtra[]
  bookings            Booking[]
  quotes              Quote[]

  @@index([status, category])
  @@index([hostProfileId])
  @@index([make])
  @@map("vehicles")
}

model VehicleImage {
  id           String        @id @default(uuid()) @db.Uuid
  vehicleId    String        @db.Uuid
  objectKey    String
  thumbnailKey String?
  width        Int?
  height       Int?
  position     Int           @default(0)
  isPrimary    Boolean       @default(false)
  altText      String?
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@map("vehicle_images")
}

model FeatureCatalog {
  code      String  @id
  label     String
  icon      String?
  category  String?
  active    Boolean @default(true)
}

model VehicleFeature {
  id           String   @id @default(uuid()) @db.Uuid
  vehicleId    String   @db.Uuid
  featureCode  String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, featureCode])
  @@map("vehicle_features")
}

model VehicleDocument {
  id                String         @id @default(uuid()) @db.Uuid
  vehicleId         String         @db.Uuid
  documentType      String
  objectKey         String
  fileName          String
  contentType       String
  insurerName       String?
  policyNumberEnc   String?
  coverType         String?
  restrictionsNote  String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  mandatory         Boolean        @default(true)
  status            DocumentStatus @default(PENDING)
  reviewerId        String?        @db.Uuid
  reviewedAt        DateTime?
  reviewNote        String?
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status, expiresAt])
  @@map("vehicle_documents")
}

model VehicleLocation {
  id                  String   @id @default(uuid()) @db.Uuid
  vehicleId           String   @unique @db.Uuid
  locationId          String?  @db.Uuid
  locationName        String?
  pickupInstruction   String?
  lat                 Float
  lng                 Float
  deliveryEnabled     Boolean  @default(false)
  defaultAirportFeeCents Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deliveryZones       DeliveryZone[]

  @@index([locationId])
  @@map("vehicle_locations")
}

model DeliveryZone {
  id                String          @id @default(uuid()) @db.Uuid
  hostProfileId     String?         @db.Uuid
  vehicleLocationId String?         @db.Uuid
  name              String
  radiusKm          Float?
  feeCents          Int             @default(0)
  isAirport         Boolean         @default(false)
  area              Json?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  hostProfile       HostProfile?    @relation(fields: [hostProfileId], references: [id])
  vehicleLocation   VehicleLocation? @relation(fields: [vehicleLocationId], references: [id], onDelete: Cascade)

  @@index([hostProfileId])
  @@map("delivery_zones")
}

model VehiclePricing {
  id                       String       @id @default(uuid()) @db.Uuid
  vehicleId                String       @unique @db.Uuid
  currency                 String       @default("KES")
  dailyPriceCents          Int
  weeklyDiscountBps        Int          @default(0)
  monthlyDiscountBps       Int          @default(0)
  minimumRentalHours       Int          @default(24)
  minimumRentalDays        Int          @default(1)
  depositRule              DepositRule  @default(FIXED)
  depositAmountCents       Int          @default(0)
  depositPercentBps        Int          @default(0)
  depositDailyMultiplierBps Int        @default(0)
  mileagePolicyType        MileagePolicyType @default(UNLIMITED)
  includedKmPerDay         Int?
  includedKmTotal          Int?
  excessPerKmCents         Int?
  fuelPolicy               FuelPolicy   @default(SAME_TO_SAME)
  lateGraceMinutes         Int          @default(60)
  lateHourlyFeeCents       Int          @default(0)
  cancellationPolicyId     String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  vehicle                  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_pricing")
}

model PricingRule {
  id              String          @id @default(uuid()) @db.Uuid
  vehicleId       String          @db.Uuid
  kind            PricingRuleKind
  startsAt        DateTime
  endsAt          DateTime
  dailyPriceCents Int
  note            String?
  createdAt       DateTime        @default(now())
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startsAt])
  @@map("pricing_rules")
}

model RentalExtra {
  id          String          @id @default(uuid()) @db.Uuid
  vehicleId   String?         @db.Uuid
  code        String
  label       String
  chargeType  ExtraChargeType
  unitCents   Int
  maxQuantity Int             @default(1)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("rental_extras")
