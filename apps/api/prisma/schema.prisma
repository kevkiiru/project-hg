// Hiregari — canonical DATA MODEL artifact (Prisma notation, PostgreSQL 16+).
// See docs/decisions/ADR-0001: the executable/ORM schema lives at
// apps/api/src/db/schema/* (Drizzle ORM); this file is the 1:1 Prisma
// representation kept as the required Prisma deliverable and ERD source.
// Money: Int minor units (cents), KES. Times: timestamptz UTC.
// Temporal exclusion constraints & immutable triggers live in the companion
// constraints.sql (neither ORM expresses btree_gist exclusions natively).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, citext]
}

