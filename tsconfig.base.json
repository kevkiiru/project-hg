{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@hiregari/types": ["packages/types/src/index.ts"],
      "@hiregari/types/*": ["packages/types/src/*"],
      "@hiregari/ui": ["packages/ui/src/index.ts"],
      "@hiregari/ui/*": ["packages/ui/src/*"],
      "@hiregari/config": ["packages/config/src/index.ts"]
    }
  }
}
